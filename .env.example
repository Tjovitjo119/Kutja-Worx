# --- Sanity (https://www.sanity.io/manage) ---------------------------------
# Until the project ID is set the site runs in DEMO MODE on built-in sample data.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Editor token (sanity.io/manage > API > Tokens). Server-side only, never prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=


# --- Admin login (NextAuth) ------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Public site URL (SEO, sitemap, Open Graph) ----------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email via Resend (https://resend.com) ----------------------------------
RESEND_API_KEY=
CONTACT_FROM_EMAIL=noreply@kutjaworx.co.za
CONTACT_TO_EMAIL=kutjaworx@gmail.com

# --- Optional: custom Google Maps embed URL ---------------------------------
GOOGLE_MAPS_EMBED_URL=
